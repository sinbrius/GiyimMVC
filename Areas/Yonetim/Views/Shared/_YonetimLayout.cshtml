<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Patron Yönetim Kokpiti</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            overflow-x: hidden;
            background-color: #f4f6f9;
        }
        .admin-sidebar {
            min-height: 100vh;
            width: 260px;
            background: linear-gradient(180deg, #1a1d24 0%, #262b36 100%);
            color: #fff;
        }
        .admin-sidebar .nav-link {
            color: #cbd5e1;
            font-size: 1rem;
            padding: 12px 18px;
            border-radius: 8px;
            margin-bottom: 6px;
            transition: all 0.2s;
        }
        .admin-sidebar .nav-link:hover, .admin-sidebar .nav-link.active {
            color: #1a1d24;
            background-color: #f59e0b;
            font-weight: 600;
        }
        .admin-sidebar .nav-link i {
            margin-right: 10px;
        }
        .admin-topbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 14px 25px;
        }
    </style>
</head>
<body>

    <div class="d-flex">
        <!-- PATRON SOL MENÜ -->
        <div class="admin-sidebar d-flex flex-column p-3 shadow">
            <a href="/Yonetim/Home/Index" class="d-flex align-items-center mb-3 text-white text-decoration-none px-2">
                <i class="bi bi-shield-lock-fill fs-3 me-2 text-warning"></i>
                <div>
                    <span class="fs-5 fw-bold d-block">Yönetim Paneli</span>
                    <small class="text-warning" style="font-size: 0.75rem;">Kurumsal Kontrol Merkezi</small>
                </div>
            </a>

            <hr class="border-secondary">

            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a href="/Yonetim/Home/Index" class="nav-link ">
                        <i class="bi bi-people-fill"></i> Personel Yönetimi
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#indirimBolumu" class="nav-link">
                        <i class="bi bi-percent"></i> İndirim Yönetimi
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Yonetim/Home/StokLoglari" class="nav-link">
                        <i class="bi bi-activity"></i> Personel Hareket Logları
                    </a>
                </li>
                
            </ul>

            <hr class="border-secondary">

            <!-- KASAYA DÖNÜŞ BUTONU -->
            <a href="/Stok/Index" class="btn btn-outline-warning w-100 fw-bold">
                <i class="bi bi-box-arrow-left me-1"></i> Kasa Ekranına Dön
            </a>
        </div>

        <!-- SAĞ ANA İÇERİK -->
        <div class="flex-grow-1 d-flex flex-column">
            <!-- ÜST BİLGİ BARI -->
            <header class="admin-topbar d-flex justify-content-between align-items-center shadow-sm">
                <span class="fw-bold text-secondary">
                    <i class="bi bi-building me-1"></i> Mağaza Yönetim Modülü
                </span>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-warning text-dark px-3 py-2">
                        <i class="bi bi-person-badge me-1"></i> Yönetici Oturumu Aktif
                    </span>
                </div>
            </header>

            <!-- SAYFA İÇERİĞİ -->
            <main class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>