@model IEnumerable<GiyimStokMvc.Models.StockTransaction>

@{
    ViewData["Title"] = "İşlem & Personel Logları";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-journal-text text-primary me-2"></i>İşlem & Personel Logları</h3>
            <p class="text-muted small mb-0">Son 20 işlem ve ödeme yöntemi detayları gösteriliyor.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
            <i class="bi bi-cart-plus me-1"></i> Kasaya Dön
        </a>
    </div>

    <!-- LOG TABLOSU -->
    <div class="card border-0 shadow-sm bg-white p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 15%;">Tarih / Saat</th>
                        <th style="width: 18%;">Personel</th>
                        <th style="width: 22%;">Ürün Adı & Varyant</th>
                        <th class="text-center" style="width: 8%;">Adet</th>
                        <th style="width: 22%;">Ödeme Tipi & Detayı</th>
                        <th style="width: 15%;">İşlem Türü</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Henüz kayıtlı bir işlem hareketi bulunmuyor.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="small fw-semibold text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@log.TransactionDate.ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        👤 @(log.User?.FullName ?? "Sistem")
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@log.ProductVariant?.Product?.Name</div>
                                    <small class="text-muted">@log.ProductVariant?.Color / @log.ProductVariant?.Size</small>
                                </td>
                                <td class="text-center fw-bold fs-6">@log.Quantity</td>
                                <td>
                                    @if (log.OdemeTipi == GiyimStokMvc.Models.OdemeTipi.Nakit)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            💵 Nakit (@log.NakitTutar.ToString("C2"))
                                        </span>
                                    }
                                    else if (log.OdemeTipi == GiyimStokMvc.Models.OdemeTipi.KrediKarti)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1">
                                            💳 K. Kartı (@log.KartTutar.ToString("C2"))
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            <span class="badge bg-warning-subtle text-dark border border-warning px-2 py-1">
                                                🧩 Parçalı Ödeme
                                            </span>
                                            <small class="text-muted style-italic" style="font-size: 0.75rem;">
                                                Nakit: @log.NakitTutar.ToString("C2") | Kart: @log.KartTutar.ToString("C2")
                                            </small>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (log.Type == GiyimStokMvc.Models.IslemTuru.Satis)
                                    {
                                        <span class="badge bg-success text-white">🟢 Satış</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">🔴 İade</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>