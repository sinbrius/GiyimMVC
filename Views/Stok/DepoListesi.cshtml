@model IEnumerable<GiyimStokMvc.Models.ProductVariant>

@{
    ViewData["Title"] = "Depo Stok Kataloğu";
    var kategoriler = Model.Select(x => string.IsNullOrWhiteSpace(x.Product?.Category) ? "Diğer" : x.Product.Category).Distinct().ToList();
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-boxes text-primary me-2"></i>Depo Stok Kataloğu</h3>
            <p class="text-muted small mb-0">Tüm ürün varyantları, stok miktarları ve kritik stok takibi.</p>
        </div>
        <a asp-action="UrunEkle" class="btn btn-success fw-bold">
            <i class="bi bi-plus-lg me-1"></i> Yeni Ürün & Stok Ekle
        </a>
    </div>

    <!-- ARAMA VE KATEGORİ FİLTRELEME ALANI -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white">
        <div class="row g-3 align-items-center">
            <!-- CANLI İSİM / BARKOD ARAMA ÇUBUĞU -->
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Ürün adı, model kodu veya barkod ile canlı ara..." autocomplete="off">
                </div>
            </div>

            <!-- KATEGORİ BUTONLARI -->
            <div class="col-md-6">
                <div class="d-flex gap-2 overflow-auto pb-1" id="kategoriFilterGroup">
                    <button type="button" class="btn btn-primary btn-sm fw-bold active-kat" onclick="kategoriFiltrele('Tümü', this)">Tümü</button>
                    @foreach (var kat in kategoriler)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm fw-bold" onclick="kategoriFiltrele('@kat', this)">@kat</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ÜRÜN KARTLARI GRID -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3" id="urunGrid">
        @foreach (var item in Model)
        {
            string resim = string.IsNullOrWhiteSpace(item.ImageUrl) ? "https://via.placeholder.com/200?text=Resim+Yok" : item.ImageUrl;
            string kategori = string.IsNullOrWhiteSpace(item.Product?.Category) ? "Diğer" : item.Product.Category;

            <div class="col urun-kart-wrapper" 
                 data-name="@(item.Product?.Name?.ToLower() ?? "")" 
                 data-barcode="@(item.Barcode?.ToLower() ?? "")" 
                 data-model="@(item.Product?.ModelCode?.ToLower() ?? "")"
                 data-category="@kategori">
                
                <div class="card h-100 border-0 shadow-sm position-relative">
                    <!-- Stok Durumu Rozeti -->
                    @if (item.StockQuantity <= item.CriticalStockLevel)
                    {
                        <span class="position-absolute top-0 end-0 m-2 badge bg-danger">Kritik Stok (@item.StockQuantity)</span>
                    }
                    else
                    {
                        <span class="position-absolute top-0 end-0 m-2 badge bg-success">Stok: @item.StockQuantity</span>
                    }

                    <img src="@resim" class="card-img-top p-2 rounded" style="height: 180px; object-fit: cover;" alt="@item.Product?.Name">
                    
                    <div class="card-body d-flex flex-column p-3">
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">@kategori | @item.Product?.ModelCode</small>
                        <h6 class="card-title fw-bold text-dark text-truncate mb-1">@item.Product?.Name</h6>
                        
                        <div class="mb-2">
                            <span class="badge bg-light text-dark border me-1">@item.Color</span>
                            <span class="badge bg-light text-dark border">@item.Size</span>
                        </div>

                        <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="fw-bold text-success fs-5">@item.SalePrice.ToString("C2")</span>
                            <small class="text-muted font-monospace" style="font-size: 0.75rem;">@item.Barcode</small>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Arama Sonucu Ürün Bulunamadı Uyarısı -->
    <div id="noResult" class="text-center py-5 d-none">
        <i class="bi bi-search fs-1 text-muted d-block mb-2"></i>
        <h5 class="text-muted">Aramanıza uygun ürün bulunamadı.</h5>
    </div>
</div>

@section Scripts {
    <script>
        let seciliKategori = 'Tümü';
        const searchInput = document.getElementById('searchInput');
        const urunKartlari = document.querySelectorAll('.urun-kart-wrapper');
        const noResult = document.getElementById('noResult');

        // CANLI İSİM / BARKOD FİLTRELEME
        searchInput.addEventListener('input', filtrele);

        // KATEGORİ FİLTRELEME
        function kategoriFiltrele(kategori, btn) {
            seciliKategori = kategori;
            
            // Buton aktiflik sınıflarını güncelle
            document.querySelectorAll('#kategoriFilterGroup .btn').forEach(b => {
                b.classList.remove('btn-primary');
                b.classList.add('btn-outline-secondary');
            });
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-primary');

            filtrele();
        }

        // ORTAK FİLTRELEME MANTIĞI
        function filtrele() {
            const aramaMetni = searchInput.value.toLowerCase().trim();
            let gorunenSayisi = 0;

            urunKartlari.forEach(kart => {
                const name = kart.getAttribute('data-name');
                const barcode = kart.getAttribute('data-barcode');
                const model = kart.getAttribute('data-model');
                const category = kart.getAttribute('data-category');

                const aramaUyumlu = name.includes(aramaMetni) || barcode.includes(aramaMetni) || model.includes(aramaMetni);
                const kategoriUyumlu = seciliKategori === 'Tümü' || category === seciliKategori;

                if (aramaUyumlu && kategoriUyumlu) {
                    kart.classList.remove('d-none');
                    gorunenSayisi++;
                } else {
                    kart.classList.add('d-none');
                }
            });

            if (gorunenSayisi === 0) {
                noResult.classList.remove('d-none');
            } else {
                noResult.classList.add('d-none');
            }
        }
    </script>
}